# ============================================================
# QuoteBox — Variables de entorno
# Copiá este archivo como .env y completá los valores.
# NUNCA commitees .env al repositorio.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://buriiwhtcgxlrksbhkqo.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# URL de conexión directa a Postgres (para APScheduler SQLAlchemyJobStore).
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-region.pooler.supabase.com:6543/postgres
# Si se deja vacío, el scheduler usa MemoryJobStore (válido para instancia única en Railway).
SUPABASE_DB_URL=

# --- Sitio a scrapear ---
SCRAPE_BASE_URL=https://quotes.toscrape.com
SCRAPE_USERNAME=ArchytasUser
SCRAPE_PASSWORD=123

# Intervalo entre corridas automáticas (en horas)
SCRAPE_INTERVAL_HOURS=24

# --- Twilio WhatsApp Sandbox ---
# Obtener en: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
# Número del sandbox (formato: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Resend (email) ---
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Destinatario de los mails de resumen de novedades
NOTIFICATION_EMAIL_TO=team@yourcompany.com
# Remitente (debe ser un dominio verificado en Resend, o usar onboarding@resend.dev en dev)
NOTIFICATION_EMAIL_FROM=QuoteBox <noreply@yourcompany.com>
# Destinatario de las alertas de escalación (autor desconocido)
ESCALATION_EMAIL_TO=team@yourcompany.com

# --- Lógica de escalación ---
# Cuántas consultas del mismo autor desconocido disparan el mail de escalación
UNKNOWN_AUTHOR_THRESHOLD=2

# --- Seguridad ---
# Secret compartido entre Supabase webhook y FastAPI.
# Generarlo con: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=generate-a-strong-random-string-here

# --- Admin panel (Streamlit → FastAPI) ---
# URL base de la API FastAPI. Localmente: http://localhost:8000
FASTAPI_BASE_URL=http://localhost:8000
